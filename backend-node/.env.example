# Server Environment Configuration
NODE_ENV=development
PORT=5001

# MySQL Database Connection URL (Prisma format)
DATABASE_URL="mysql://root:1234@localhost:3306/node_app_db"

# JWT Authentication Secrets
JWT_SECRET="super-secret-jwt-key-for-interview-demo-change-in-prod-12345"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-for-interview-demo-change-in-prod-67890"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
